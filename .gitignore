# ---------------------------------------------------------------------------
*.bak
*.orig
*.old
*.save
*.tmp
*.temp
*.rej
*.stackdump
**/* copy.*

# ---------------------------------------------------------------------------
# Images: binary assets are opted in explicitly (existing tracked images keep
# working; a new image under assets/img needs `git add -f`)
# ---------------------------------------------------------------------------
*.png
!assets/img/*.png

